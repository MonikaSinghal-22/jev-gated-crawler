# === TypeSafe Direct (default) ===
# Sign up at console.typesafe.ai
TYPESAFE_API_KEY=your-api-key-here

# === OR: Opper Gateway ===
# Sign up at opper.ai (no waitlist, no credit card to start)
# Uncomment these two lines:
# JEV_PROVIDER=opper
# TYPESAFE_API_KEY=your-opper-api-key-here

# === Optional: override model version ===
# JEV_MODEL=jev-latest
